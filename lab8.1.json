// Set up SVG dimensions
var w = 600;
var h = 600;

// Define the SVG element
var svg = d3.select("svg")
    .attr("width", w)
    .attr("height", h);

// Define a Mercator projection
var projection = d3.geoMercator()
    .center([145, -36.5]) // Center it around Victoria
    .translate([w / 2, h / 2]) // Move the map to the center of the SVG
    .scale(2450); // Adjust the scale for a good fit

// Define a path generator using the projection
var path = d3.geoPath().projection(projection);

// Load the GeoJSON file (replace 'LGA_VIC.json' with your actual file name if different)
d3.json("LGA_VIC.json").then(function(json) {
    svg.selectAll("path")
        .data(json.features)
        .enter()
        .append("path")
        .attr("d", path)
        .attr("fill", "#888")  // Fill color for the LGAs
        .attr("stroke", "#000") // Border color for each LGA
        .attr("stroke-width", 0.5);
}).catch(function(error) {
    console.error("Error loading the GeoJSON file:", error);
});
